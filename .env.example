# Copy to .env.local (git-ignored). Public values only: everything NEXT_PUBLIC_* is shipped to the browser.

# CRM backend REST API, INCLUDING the /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# CRM backend origin for Socket.IO (no /api). Leave empty to disable realtime notifications.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Separate Luminedge booking/mock-test server (serves /api/v1/*). NOT the CRM backend.
# Used by components/bdm/AvailableSchedules.tsx; set it in the Netlify environment.
NEXT_PUBLIC_API_BASE_URL=

# Optional override for the public schedules feed (defaults to the Luminedge booking server).
NEXT_PUBLIC_LUMINEDGE_SCHEDULES_URL=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
